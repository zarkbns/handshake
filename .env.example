# Public testnet RPC endpoints. Replace with provider-specific URLs if needed.
CREDITCOIN_RPC_URL=https://rpc.cc3-testnet.creditcoin.network
ETHEREUM_SEPOLIA_RPC_URL=https://ethereum-sepolia-rpc.publicnode.com
ATTESTCOIN_PROOF_BUILDER_URL=https://prover.cc3-testnet.creditcoin.network
ATTESTCOIN_CHAIN_KEY=1

# Fill these after deployment.
HANDSHAKE_ASC_ADDRESS=
ETHEREUM_LOCK_ADDRESS=
CREDITCOIN_LOCK_ADDRESS=

# Source-chain commit-status adapter that reports finalized Creditcoin COMMIT to Ethereum Sepolia.
# Must be a message-verified adapter, never a caller-controlled boolean (see DEPLOYMENT.md).
ETHEREUM_COMMIT_STATUS_ADDRESS=

# Operator authorized to sign Creditcoin COMMIT reports for the Ethereum adapter.
# Use a dedicated key for the off-chain relay worker (scripts/commit-relay.js).
# OPERATOR_PRIVATE_KEY=
# OPERATOR_ADDRESS=
# Creditcoin finality depth before a COMMIT is considered final for relay.
CREDITCOIN_FINALITY_CONFIRMATIONS=10
# Delay (seconds) between a commit report being accepted and release being authorized.
COMMIT_DELAY=300

# Griefing bond posted by BOTH parties at PREPARE, in wei of native CTC (default 0.01 CTC).
# On a dual-PREPARE stall that never COMMITs, HANDSHAKE_BOND_BURN_BPS of each bond is burned and
# the rest is refunded; a single-leg no-show refunds the honest first mover in full.
HANDSHAKE_BOND_AMOUNT_WEI=10000000000000000
# Burn fraction (basis points, 10000 = 100%) applied to each bond on a dual-PREPARE stall.
HANDSHAKE_BOND_BURN_BPS=5000

# Keep all signer keys and API credentials local. Never commit them.
# DEPLOYER_PRIVATE_KEY=
# SELLER_PRIVATE_KEY=
# BUYER_PRIVATE_KEY=
# CREDITCOIN_WALLET_PRIVATE_KEY=
