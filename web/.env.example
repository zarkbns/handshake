# Handshake dashboard — public runtime configuration.
#
# Everything here is read-only public chain data and is inlined into the browser
# bundle by Next.js. Never add a private key, mnemonic, or API secret to a
# NEXT_PUBLIC_ variable. The signer keys used by the demo scripts
# (DEPLOYER_PRIVATE_KEY, SELLER_PRIVATE_KEY, BUYER_PRIVATE_KEY,
# OPERATOR_PRIVATE_KEY) are server-side only and must never appear in this file.
#
# Copy to web/.env.local to enable live coordinator lookups by settlement id.
# Without these the dashboard still renders, using the clearly-labelled sample
# source, and live lookup is disabled with an explanatory message.

# Required for live settlement lookups.
NEXT_PUBLIC_CREDITCOIN_RPC_URL=https://rpc.cc3-testnet.creditcoin.network
NEXT_PUBLIC_HANDSHAKE_ASC_ADDRESS=0x905E0f141D8B5333F49755B08395d1beAdEd74Ab

# Optional. Resolves custody detail (token, amounts, depositor, expiry) on the
# settlement detail page.
NEXT_PUBLIC_ETHEREUM_SEPOLIA_RPC_URL=https://ethereum-sepolia-rpc.publicnode.com
NEXT_PUBLIC_CREDITCOIN_LOCK_ADDRESS=0xb3e9cB40A52EF777A29b6198f4c2D8d19893a01D
NEXT_PUBLIC_ETHEREUM_LOCK_ADDRESS=0x999326d027316C6CD0156a39ac8d3792f2EFC802
